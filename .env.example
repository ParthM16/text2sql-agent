# ───────────────────────────────────────────────────────────
# .env.example — Safe template for sharing / GitHub
# Copy this file to .env and fill in your actual credentials
# ───────────────────────────────────────────────────────────

# Database details for SQL Server connection
DB_DRIVER="ODBC Driver 17 for SQL Server"
DB_SERVER_NAME=".\SQLEXPRESS"
DB_DATABASE_NAME="your_database_name"
DB_USER=""          # Leave empty for Windows Authentication
DB_PASSWORD=""      # Leave empty for Windows Authentication

# ── Google AI Credentials ────────────────────────────────────
# Use GEMINI_API_KEY for Google AI Studio (preferred to avoid duplicate key warnings)
GEMINI_API_KEY="your_api_key_here"   # Get from https://aistudio.google.com/app/apikey

# Vertex AI settings (only needed if using GCP Vertex AI mode)
PROJECT_ID=""                        # Leave empty to use Gemini API mode
LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS=""    # Path to service_account.json (if Vertex AI)

# ── Multi-Model AI Engine (Single Source of Truth) ───────────
# Primary provider default: 'gemini-3.8-flash' or 'ollama/qwen2.5-coder:3b'
LLM_PROVIDER="gemini-3.8-flash"

# Gemini Cloud Model (e.g. gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3-flash-preview)
GEMINI_MODEL="gemini-3.8-flash"

# Ollama Local Model (e.g. qwen2.5-coder:3b, llama3.2:3b)
OLLAMA_MODEL="qwen2.5-coder:3b"
OLLAMA_BASE_URL="http://localhost:11434"

# ── Vector Database Configuration ───────────────────────────
# Options: 'faiss' (in-memory L2 search, default) or 'chroma' (persistent local ChromaDB)
VECTOR_BACKEND="faiss"
